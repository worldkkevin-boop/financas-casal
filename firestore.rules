rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mapa usuário → casal. Cada um lê/escreve só o próprio (login Google).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cada casal é um documento. No máximo 2 membros (vocês dois).
    match /couples/{coupleId} {

      // Criar o casal: precisa estar logado.
      allow create: if request.auth != null;

      // Ler/editar/excluir: precisa estar logado E
      //  - ser um membro já registrado, OU
      //  - ainda haver vaga (menos de 2 membros) — é assim que o parceiro(a) entra pelo convite, OU
      //  - documento antigo sem o campo 'members' (compatibilidade).
      allow read, update, delete: if request.auth != null && (
        !('members' in resource.data) ||
        request.auth.uid in resource.data.members ||
        resource.data.members.size() < 2
      );
    }
  }
}
