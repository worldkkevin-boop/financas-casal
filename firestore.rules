rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mapa usuário → casal. Cada um lê/escreve só o próprio (login Google).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cada casal é um documento. No máximo 2 membros (vocês dois).
    match /couples/{coupleId} {
      // ... (existing rules)
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        !('members' in resource.data) ||
        request.auth.uid in resource.data.members ||
        resource.data.members.size() < 2
      );
    }

    // Gerenciamento de IA: Totalmente privado, apenas o dono do dado acessa.
    match /ai_management/{docId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }
  }
}
